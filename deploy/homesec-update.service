[Unit]
Description=HomeSec pull-deploy from GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# A root-owned copy: the working tree belongs to the user that runs the LAN-facing panel, and root
# must not execute a file that user can edit. update.sh refreshes the copy after a verified deploy.
ExecStart=/bin/bash /usr/local/sbin/homesec-update
