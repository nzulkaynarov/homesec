# ==============================================================================
# HomeSec — Конфигурация и ключи через GitHub
# ==============================================================================
# Этот файл отслеживается в Git. Вы можете менять настройки прямо в GitHub:
# откройте файл на github.com, нажмите иконку карандаша (Edit), внесите правки
# и нажмите "Commit changes".
#
# Малинка (Raspberry Pi) автоматически стягивает изменения каждую минуту через
# systemd таймер homesec-update.timer, переносит ключи в рабочий .env и
# перезапускает сервис панели и бота.

# ИИ-шлюз LunaGPT на основном сервере (192.168.88.241)
HS_AI_BASE_URL=http://192.168.88.241:4000
HS_STT_URL=http://192.168.88.241:8010/v1/audio/transcriptions
# HS_ANTHROPIC_API_KEY is a secret: set it only in /opt/homesec/backend/.env on the Pi.
# This repository is public, so never add the key to this file.

# Модели ИИ (направляются в LiteLLM шлюз LunaGPT)
HS_AI_MODEL_LOCAL=luna-coder
HS_AI_MODEL=claude-haiku-4-5
HS_AI_MODEL_FAST=claude-haiku-4-5
